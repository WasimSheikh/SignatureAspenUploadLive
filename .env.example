APP_URL=http://localhost:3000
DATABASE_URL=postgresql://localhost:5432/designfileuploads
AWS_REGION=us-east-1
S3_BUCKET=your-private-transfer-bucket
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
# For Cloudflare R2 or another S3-compatible provider:
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
RESEND_API_KEY=
FROM_EMAIL=Design Delivery <transfers@example.com>
INTERNAL_NOTIFICATION_EMAILS=design@example.com
# Generate independent random values with: openssl rand -hex 32
COOKIE_SECRET=
CRON_SECRET=
ENABLE_EXPIRATION_REMINDERS=false
# Optional server limits (UI supports at most 100 files):
MAX_TRANSFER_BYTES=21474836480
MAX_TRANSFER_FILES=100
MAX_TRANSFER_RECIPIENTS=20
DATABASE_POOL_MAX=10
