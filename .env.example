APP_URL=http://localhost:3000
DATABASE_URL=postgresql://localhost:5432/designfileuploads
AZURE_STORAGE_ACCOUNT_NAME=yourstorageaccount
AZURE_STORAGE_CONTAINER=design-transfers
# Leave empty on Azure to use managed identity + user-delegation SAS.
# Optional local fallback: storage account access key (server only).
AZURE_STORAGE_ACCOUNT_KEY=
# Local service principal for DefaultAzureCredential (separate from employee SSO):
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
RESEND_API_KEY=
FROM_EMAIL=Signature Aspen <transfers@example.com>
INTERNAL_NOTIFICATION_EMAILS=design@example.com
# Generate independent random values with: openssl rand -hex 32
COOKIE_SECRET=
CRON_SECRET=
ENABLE_EXPIRATION_REMINDERS=false
# Optional server limits (UI supports at most 100 files):
MAX_TRANSFER_BYTES=21474836480
MAX_TRANSFER_FILES=100
MAX_TRANSFER_RECIPIENTS=20
DATABASE_POOL_MAX=10

# Optional Microsoft Entra ID employee workspace (all four required to enable).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_ALLOWED_GROUP_IDS=
# Members must also belong to an allowed group. Leave empty for assigned-only access.
ENTRA_ADMIN_GROUP_IDS=

# Optional Linux NAS mirror. Cloud remains the canonical source.
NAS_ENABLED=false
# Generate an independent secret; share only between app and local NAS service.
NAS_SIGNING_SECRET=
NAS_LOCAL_URL=https://files.office.example.com
NAS_ROOT=/mnt/nas/design-delivery
NAS_BIND_HOST=127.0.0.1
NAS_PORT=8787
NAS_SYNC_INTERVAL_MS=30000
